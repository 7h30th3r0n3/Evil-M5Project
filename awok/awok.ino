            if (packetSize > 0) {
              uint8_t packetBuffer[DHCP_BUFFER_SIZE];
              int readLen = min(packetSize, (int)sizeof(packetBuffer));
              udp.read(packetBuffer, readLen);
      
              uint8_t messageType = parseDHCPMessageType(packetBuffer, readLen);
