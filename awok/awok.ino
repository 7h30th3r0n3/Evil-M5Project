bool confirmPopup(String message) {
  bool confirm = false;
  bool decisionMade = false;

  M5.Display.clear();
  M5.Display.setTextSize(1.5);
  int messageWidth = M5.Display.textWidth(message);
  int startX = (M5.Display.width() - messageWidth) / 2; if (startX < 0) startX = 0;

  M5.Display.setCursor(startX, M5.Display.height() / 2);
  M5.Display.setTextColor(menuTextUnFocusedColor, TFT_BLACK);
  M5.Display.println(message);

  M5.Display.setTextColor(TFT_RED);
  M5.Display.setCursor(6, 110);
  M5.Display.print("<N");          // Gauche = Non

  M5.Display.setTextColor(TFT_GREEN);
  M5.Display.setCursor(M5.Display.width() - 24, 110);
  M5.Display.print("Y>");          // Droite = Oui

  M5.Display.setTextColor(menuTextFocusedColor, menuBackgroundColor);
  M5.Display.display();

  while (!decisionMade) {
    M5.update();
    cardUpdate();
    handleDnsRequestSerial();

    if (kp('y') || kp('/')) {                 // 'y' clavier OU Droite joystick
      confirm = true;
      decisionMade = true;
    } else if (kp('n') || kp(KEY_BACKSPACE)) {  // 'n' clavier OU Gauche joystick
      confirm = false;
      decisionMade = true;
    }
  }

  return confirm;
}


