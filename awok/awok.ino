  server.sendHeader("Last-Modified", "Tue, 15 Nov 1994 12:45:26 GMT");
  server.sendHeader("Access-Control-Allow-Origin", "*");

  // Envoi de la réponse avec le contenu HTML
  server.send(200, "text/html", payload);
