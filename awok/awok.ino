String getUserInput(bool isPassword = false, bool allowEmpty = false) {
  String input = "";
  M5.Display.setTextSize(1.5);
  M5.Display.setTextColor(TFT_WHITE, TFT_BLACK);
  M5.Display.setCursor(5, 30);
  vkActive = true;              // active le clavier virtuel (joystick)
  vkEnterDebounce();            // anti-rebond entrée saisie
  while (true) {
    cardUpdate();
    // ── Physical keyboard ──
    if (M5Cardputer.Keyboard.isChange()) {
      if (kpAny()) {
        Keyboard_Class::KeysState status = M5Cardputer.Keyboard.keysState();

        for (auto i : status.word) {
          input += i;
        }

        if (status.del && input.length() > 0) {
          input.remove(input.length() - 1);
          M5.Display.setCursor(5, 30);
          M5.Display.print("                                          ");
        }

        if (status.enter) { vkActive = false; return input; }   // OK VK: valide toujours

        M5.Display.setCursor(5, 30);
        M5.Display.print(input);
        M5.Display.display();
      }
    }
    // ── Web navigation commands (Enter/Back from PC keyboard) ──
    if (navPendingAction == NAV_ENTER) {
      navPendingAction = NAV_NONE;
      if (allowEmpty || input.length() > 0) { vkActive = false; return input; }
    } else if (navPendingAction == NAV_BACK) {
      navPendingAction = NAV_NONE;
      if (input.length() > 0) {
        input.remove(input.length() - 1);
        M5.Display.setCursor(5, 30);
        M5.Display.print("                                          ");
        M5.Display.setCursor(5, 30);
        M5.Display.print(input);
        M5.Display.display();
      }
    }
    // ── Web virtual keyboard characters ──
    if (navPendingCharValid) {
      uint8_t c = navPendingChar;
      navPendingCharValid = false;
      navPendingChar = 0;

      if (c == KEY_BACKSPACE) {
        if (input.length() > 0) {
          input.remove(input.length() - 1);
          M5.Display.setCursor(5, 30);
          M5.Display.print("                                          ");
        }
      } else if (c == KEY_ENTER) {
        vkActive = false; return input;   // OK clavier virtuel: valide toujours
      } else if (c >= 32 && c < 127) {
        input += (char)c;
      }

      M5.Display.setCursor(5, 30);
      M5.Display.print(input);
      M5.Display.display();
    }
    // AWOK: redessine la ligne de saisie CHAQUE frame avec taille/couleur+fond
    // explicites. drawVirtualKeyboard() laisse la police en taille 1 + fond
    // transparent, ce qui cassait l'effacement (le caractère "delete" restait
    // affiché). Les espaces de fin effacent proprement la queue de ligne.
    M5.Display.setTextSize(1.5);
    M5.Display.setTextColor(TFT_WHITE, TFT_BLACK);
    M5.Display.setCursor(5, 30);
    M5.Display.print(input + "                              ");
    drawVirtualKeyboard();     // grille clavier en bas, redessinée chaque frame
    delay(100);
  }
}
