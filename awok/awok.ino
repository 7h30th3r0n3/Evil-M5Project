// Fonction pour arrêter la lecture
void stop(void) {
  if (id3 == nullptr) return;
  out.stop();
  mp3.stop();
  id3->close();
  file.close();
  delete id3;
  id3 = nullptr;
}

// Fonction pour lire un fichier MP3
void play(const char* fname) {
  if (id3 != nullptr) {
    stop();
  }
  file.open(fname);
  id3 = new AudioFileSourceID3(&file);
  id3->open(fname);
  mp3.begin(id3, &out);
}

