static inline char lc(char c) {
  return (c >= 'A' && c <= 'Z') ? (c + 32) : c;
}

static bool icase_contains_flash(const char* hay, const char* needle, uint8_t nlen) {
  if (nlen == 0) return true;
  for (uint16_t i = 0; hay[i]; ++i) {
    if (lc(hay[i]) == lc(needle[0])) {
      uint8_t j = 1;
      while (needle[j] && hay[i + j] && (lc(hay[i + j]) == lc(needle[j]))) ++j;
      if (j == nlen) return true;
    }
  }
  return false;
}

// AWOK: masque les items indisponibles sur ce hardware (USB HID, SD-USB natif,
// CC1101, NFC, IR, SSH désactivé, carte C5). Réutilise le filtre du menu.
static inline bool menuItemAvailable(int i) {
  switch (i) {
    case 35: // SSH Shell (AWOK_ENABLE_SSH=0)
    case 43: // Mouse Jiggler (USB HID)
    case 44: // BadUSB (USB HID)
    case 45: // Bluetooth Keyboard (clavier matriciel requis)
    case 56: // LLM Chat Stream (retiré)
    case 58: // SD on USB (USB natif)
    case 64: // UART Shell (retiré)
    case 82: // ESP32C5 Serial (autre carte)
    case 86: // TagTinker ESL (IR/S3)
    case 88: // Totem Compass (IMU absent + BLE OOM + LoRa stub)
    case 89: // Cap Sub-GHz (CC1101)
    case 90: // Cap NFC
      return false;
    default:
      return true;
  }
}

void rebuildMenuFilter() {
  menuFilteredCount = 0;
  if (menuSearchLen == 0) {
    for (int i = 0; i < menuSize; ++i) if (menuItemAvailable(i)) menuFilteredIdx[menuFilteredCount++] = i;
    Serial.printf("[SEARCH] query='(empty)' -> %d match(es)\n", (int)menuFilteredCount);
    return;
  }
  for (int i = 0; i < menuSize; ++i) {
    if (!menuItemAvailable(i)) continue;
    const char* it = (const char*)menuItems[i];
    if (icase_contains_flash(it, menuSearchQuery, menuSearchLen)) {
      menuFilteredIdx[menuFilteredCount++] = i;
    }
  }
  Serial.printf("[SEARCH] query='%s' -> %d match(es)\n", menuSearchQuery, (int)menuFilteredCount);
}

int viewCount() {
  return (int)menuFilteredCount;   // AWOK: filtre toujours actif (items dispos)
}

int mapViewToRealIndex(int pos) {
  if (pos < 0 || pos >= (int)menuFilteredCount) return 0;
  return menuFilteredIdx[pos];   // AWOK: toujours via le filtre
}

void clampMenuSelection() {
  int total = viewCount();
  if (total <= 0) {
    currentIndex = 0;
    menuStartIndex = 0;
    return;
  }
  if (currentIndex >= total) currentIndex = total - 1;
  if (currentIndex < 0) currentIndex = 0;
  menuStartIndex = std::max(0, std::min(currentIndex, total - maxMenuDisplay));
}

char getPrintableKey() {
  for (int c = 32; c <= 126; ++c) {
    if (kp((char)c)) return (char)c;
  }
  return 0;
}

void drawSearchBar() {
  const int barH = 12;
  const int y = M5.Display.height() - barH;

  // Fond barre
  M5.Display.fillRect(0, y, M5.Display.width(), barH, TFT_BLACK);

  // IMPORTANT: fixer la taille du texte pour ne pas hériter du zoom menu
  M5.Display.setTextFont(1);
  M5.Display.setTextSize(1.5f);                 // <= stable à tous les zooms
  M5.Display.setTextColor(TFT_YELLOW, TFT_BLACK);

  M5.Display.setCursor(5, y + 1);
  M5.Display.print("Search: ");
  M5.Display.print(menuSearchQuery);
}


void enterSearchMode() {
  if (menuMode != MENU_SEARCH) {
    menuMode = MENU_SEARCH;
    menuFilterLocked = false;
    rebuildMenuFilter();
    currentIndex = 0;
    menuStartIndex = 0;
    lastIndex = -1;
    Serial.println("[SEARCH] enter");
  }
  drawMenu();
  drawSearchBar();
}

// Quitte la recherche : si query vide => menu complet (pas de filtre verrouillé),
// sinon on verrouille la vue filtrée
void exitSearchModeAuto() {
  menuMode = MENU_NAVIGATION;
  menuFilterLocked = (menuSearchLen > 0);
  clampMenuSelection();
  lastIndex = -1;
  Serial.printf("[SEARCH] exit -> %s\n", menuFilterLocked ? "keep filtered view" : "full menu");
  drawMenu();
}

// BACKSPACE en mode recherche : effacer 1 caractère (si vide, on reste en recherche
// avec liste complète)
void clearSearchBackspaceOne() {
  if (menuSearchLen > 0) {
    menuSearchQuery[--menuSearchLen] = '\0';
  }
  rebuildMenuFilter();
  currentIndex = 0;
  menuStartIndex = 0;
  lastIndex = -1;
  drawMenu();
  drawSearchBar();
}




void applyMenuZoomLayout() {
  // 1) Choix des 3 tailles demandées
  switch (menuZoomLevel) {
    case 0: menuTextSize = 1.5f; menuLineH = 10; break;  // AWOK: +3 items visibles
    case 1: menuTextSize = 2.0f; menuLineH = 18; break;
    case 2: menuTextSize = 2.5f; menuLineH = 22; break;
    default: menuZoomLevel = 0; menuTextSize = 1.5f; menuLineH = 13; break;
  }

  // 2) Calcul du nombre de lignes affichables, en réservant la barre Search si besoin
  int reserveBottom = (menuMode == MENU_SEARCH) ? SEARCH_BAR_H : 0;
  int availableH = M5.Display.height() - MENU_TOP_Y - reserveBottom;

  int lines = availableH / menuLineH;
  if (lines < 3) lines = 3;          // sécurité
  if (lines > 12) lines = 12;        // limite raisonnable (évite du rendu illisible)
  maxMenuDisplay = lines;

  // 3) Clamp selection pour éviter index hors vue
  clampMenuSelection();  
}

void cycleMenuZoom() {
  menuZoomLevel = (menuZoomLevel + 1) % 3;  // 0->1->2->0
  applyMenuZoomLayout();
  lastIndex = -1; // force redraw dans loop (comme ton code le fait déjà)
  drawMenu();
}

//-----------------------------------------------------------------------------------------------------
void drawMenu() {
  // Toujours recalculer le layout ici (au cas où on entre/sort de SEARCH)
  applyMenuZoomLayout();

  int reserveBottom = (menuMode == MENU_SEARCH) ? SEARCH_BAR_H : 0;
  int listH = (M5.Display.height() - MENU_TOP_Y) - reserveBottom;

  // Efface uniquement la zone liste (pas la barre search)
  M5.Display.fillRect(0, MENU_TOP_Y, M5.Display.width(), listH, menuBackgroundColor);

  M5.Display.setTextSize(menuTextSize);
  M5.Display.setTextFont(1);

  const int startX = 0;   // AWOK: marge gauche nulle (gagne une lettre)
  const int startY = 12;

  const int total = viewCount();  // respecte SEARCH + lock 

  for (int i = 0; i < maxMenuDisplay; ++i) {
    int pos = menuStartIndex + i;
    if (pos >= total) break;

    int menuIndex = mapViewToRealIndex(pos); // respecte filtre 

    if (pos == currentIndex) {
      M5.Display.fillRect(0, 1 + startY + i * menuLineH,
                          M5.Display.width(), menuLineH,
                          menuSelectedBackgroundColor);
      M5.Display.setTextColor(menuTextFocusedColor);
    } else {
      M5.Display.setTextColor(menuTextUnFocusedColor);
    }

    int y = startY + i * menuLineH + (menuLineH / 2) - 3;
    if (y < MENU_TOP_Y) y = MENU_TOP_Y;

    M5.Display.setCursor(startX, y);
    M5.Display.println((const char*)menuItems[menuIndex]);
  }

  // Barre Search inchangée
  if (menuMode == MENU_SEARCH) drawSearchBar();

  M5.Display.display();
}




